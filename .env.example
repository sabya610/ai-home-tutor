# Copy to .env and fill in. Leave AI_MODE=mock to run fully offline.

# auto | openai | mock  (auto = real when a key/endpoint exists, else mock)
AI_MODE=auto

# Your OpenAI key (shared default for both roles unless overridden below).
OPENAI_API_KEY=

# Optional: OpenAI-compatible internal endpoint (shared default).
# OPENAI_BASE_URL=

# --- Vision role (handwriting OCR) — needs a vision-capable model ---
VISION_MODEL=gpt-4o
# VISION_BASE_URL=
# VISION_API_KEY=

# --- Tutor role (hints/scoring/explanations) — can be cluster llama3 ---
TUTOR_MODEL=gpt-4o-mini
# Point at cluster llama3 (rag-app OpenAI endpoint). See cluster/README.md.
# TUTOR_BASE_URL=http://localhost:8080/v1
# TUTOR_MODEL=llama3.1-8b
# TUTOR_API_KEY=not-needed
# auto | json | prompt  (llama.cpp usually needs prompt-based JSON)
TUTOR_JSON_MODE=auto

DB_PATH=data/tutor.db

# Optional Tapo C201 RTSP source.
# TAPO_RTSP_URL=rtsp://user:pass@192.168.1.50:554/stream1
